# Paventra Backend — Environment Configuration
# Copy this file to .env and adjust values before running

# App
APP_NAME=Paventra
DEBUG=false
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-secret-key-before-production

# Database (SQLite for local dev; change to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./paventra.db

# For PostgreSQL (requires Docker or a running PG instance):
# DATABASE_URL=postgresql+asyncpg://paventra:paventra@localhost:5432/paventra

# Auth
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (Optional — leave disabled if credentials are not provisioned)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/login

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Computer Vision model
# Set MODEL_ENABLED=true and provide MODEL_WEIGHTS_PATH to enable AI inference.
# Download a YOLOv8 road damage checkpoint and set the path here.
# See ml/model_cards/yolov8_road_damage.md for instructions.
MODEL_ENABLED=false
MODEL_WEIGHTS_PATH=
MODEL_CONFIDENCE_THRESHOLD=0.4
MODEL_DEVICE=cpu

# CORS — frontend origins allowed to call this API
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
